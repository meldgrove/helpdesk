# Fake but valid settings for the compose compatibility job (ci.yml): what a
# server of the newest release has in its .env. The job sets HELPDESK_VERSION
# and COMPOSE_FILE. Public file: no real secrets.
POSTGRES_PASSWORD=compat-only-password
DATABASE_URL=postgres://helpdesk:compat-only-password@postgres:5432/helpdesk
APP_URL=https://helpdesk.example.invalid
AUTH_SECRET=compat-only-not-a-secret-compat-only-not-a-secret
ENCRYPTION_KEY=Y29tcGF0LW9ubHktbm90LWEtc2VjcmV0LWtleS0wMDE=
OIDC_ISSUER=https://sso.example.invalid/realms/helpdesk
OIDC_CLIENT_ID=helpdesk
OIDC_CLIENT_SECRET=compat-only
